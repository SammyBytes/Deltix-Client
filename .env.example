# Deltix-Client environment configuration
# Copy to .env for local development. NEVER commit a real .env file.
# All values below are validated at boot time (see src/shared/env.ts).

NODE_ENV=development

# --- Session / Auth (Fase 2) ---
# Base URL of the Deltix-Server REST API this CLI talks to.
DELTIX_SERVER_URL=http://127.0.0.1:9090

# Optional override for where the local refresh-token credentials file lives.
# Defaults to ~/.deltix/credentials.json (written with 0600 permissions).
# DELTIX_CREDENTIALS_PATH=/custom/path/credentials.json

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true
