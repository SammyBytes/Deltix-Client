{
  "name": "deltix-client",
  "version": "0.7.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Deltix Developer CLI (Bun/TypeScript). MIT licensed for maximum adoption.",
  "bin": {
    "deltix": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build ./src/cli/index.ts --compile --outfile dist/deltix",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:smoke": "bun test tests/smoke"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "consola": "^3.4.2",
    "mysql2": "^3.24.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.4.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
